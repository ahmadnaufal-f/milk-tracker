rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function userCleanupLeaseIsInactive(userId) {
      let profilePath = /databases/$(database)/documents/users/$(userId);
      return !exists(profilePath) ||
        get(profilePath).data.get('guestCleanupLeaseExpiresAt', null) == null ||
        (get(profilePath).data.get('guestCleanupLeaseExpiresAt', null) is timestamp &&
          get(profilePath).data.get('guestCleanupLeaseExpiresAt', null) <= request.time);
    }

    function cleanupMetadataIsUnchanged() {
      return request.resource == null ||
        (resource == null
          ? !request.resource.data.keys().hasAny([
              'guestCleanupStartedAt', 'guestCleanupLeaseExpiresAt', 'guestCleanupId'
            ])
          : !request.resource.data.diff(resource.data).affectedKeys().hasAny([
              'guestCleanupStartedAt', 'guestCleanupLeaseExpiresAt', 'guestCleanupId'
            ]));
    }

    function guestMarkerIsMonotonic() {
      return resource == null ||
        resource.data.get('isAnonymous', null) != false ||
        (request.resource != null && request.resource.data.get('isAnonymous', null) == false);
    }

    function migratedGuestProfileAllowsAccess(userId) {
      let profilePath = /databases/$(database)/documents/users/$(userId);
      let token = request.auth.token;
      let firebaseClaims = token.get('firebase', {});
      return token.get('guestMigration', false) != true ||
        firebaseClaims.get('sign_in_provider', '') != 'custom' ||
        (exists(profilePath) && get(profilePath).data.get('isAnonymous', false) == true);
    }

    // Guest transfer grants and rate-limit state are backend-only.
    match /guestMigrations/{migrationId} {
      allow read, write: if false;
    }

    match /guestMigrationRateLimits/{rateLimitId} {
      allow read, write: if false;
    }
    
    // The profile marker may be changed from guest to linked once, but never reset.
    match /users/{userId} {
      // Only allow access if the user is authenticated and their UID matches the path
      allow read: if request.auth != null && request.auth.uid == userId && migratedGuestProfileAllowsAccess(userId);
      allow write: if request.auth != null && request.auth.uid == userId &&
        migratedGuestProfileAllowsAccess(userId) && userCleanupLeaseIsInactive(userId) &&
        cleanupMetadataIsUnchanged() && guestMarkerIsMonotonic();
    }

    // User-owned sessions and other subcollections use their own document data;
    // this separate match keeps profile-only marker rules from overlapping them.
    match /users/{userId}/{collection}/{document=**} {
      allow read: if request.auth != null && request.auth.uid == userId && migratedGuestProfileAllowsAccess(userId);
      allow write: if request.auth != null && request.auth.uid == userId &&
        migratedGuestProfileAllowsAccess(userId) && userCleanupLeaseIsInactive(userId) && cleanupMetadataIsUnchanged();
    }
    
  }
}
