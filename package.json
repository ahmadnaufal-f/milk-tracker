{
  "name": "milk-pump-tracker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "deploy": "vite build && firebase deploy --only hosting",
    "test": "npm run test:unit",
    "test:unit": "vitest run --config vitest.config.ts && npm --prefix functions run test:unit",
    "test:integration": "npm --prefix functions run build && GUEST_MIGRATION_TEST_ENABLED=true GUEST_MIGRATION_TEST_CAMPAIGN_ID=migration-emulator-v1 GUEST_MIGRATION_TEST_SOURCE_ORIGINS=https://old.example.test GUEST_MIGRATION_TEST_DESTINATION_ORIGIN=https://pump.arkaes.dev firebase emulators:exec --project demo-milk-tracker-migration --only auth,firestore,functions --non-interactive \"vitest run --config vitest.integration.config.ts\"",
    "build:functions": "npm --prefix functions run build"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@tailwindcss/vite": "^4.1.18",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "firebase": "^12.7.0",
    "lucide-react": "^0.562.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.0",
    "react-day-picker": "^9.13.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.11.0",
    "recharts": "^3.6.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.18",
    "workbox-window": "^7.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "firebase-admin": "^13.6.0",
    "firebase-functions": "^7.0.3",
    "firebase-tools": "^15.32.1",
    "globals": "^16.5.0",
    "jsdom": "^26.1.0",
    "motion": "^12.38.0",
    "openai": "^6.38.0",
    "react-markdown": "^10.1.0",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "npm:rolldown-vite@7.2.5",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "3.2.4"
  },
  "packageManager": "pnpm@11.19.0"
